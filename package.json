{
  "name": "btm-corporate",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit up && drizzle-kit push && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:migrateprod": "NODE_ENV=production vite ./src/db/migrate.server.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.28.1",
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@types/eslint": "^8.56.7",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.11.10",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.24.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.36.0",
    "globals": "^15.0.0",
    "postcss": "^8.4.39",
    "prettier": "^3.1.1",
    "prettier-plugin-svelte": "^3.1.2",
    "svelte": "^4.2.7",
    "svelte-check": "^3.6.0",
    "sveltekit-superforms": "^2.16.1",
    "tailwindcss": "^3.4.6",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0-alpha.20",
    "vite": "^5.0.3",
    "zod": "^3.23.8"
  },
  "type": "module",
  "dependencies": {
    "@tadashi/svelte-notification": "^1.3.0",
    "amadeus": "^10.1.0",
    "axios": "^1.7.7",
    "country-flag-emoji": "^1.0.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "flag-icon-css": "^4.1.7",
    "isomorphic-crypto": "^3.0.0",
    "node-postgres": "^0.6.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.0",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "swiper": "^11.1.10",
    "toastify-js": "^1.12.0",
    "uuid": "^10.0.0"
  }
}
